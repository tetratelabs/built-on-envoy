---
import ExtensionCard from './ExtensionCard.astro';
import { applyHighlights, loadExtensions } from '../utils/extensions';

// Highlighted extensions are always shown (first), followed by the featured ones.
const featuredExtensions = applyHighlights(loadExtensions()).filter(ext => ext.highlight || ext.featured === true);
---

<section class="extensions" id="extensions">
	<div class="container">
		<h2>Featured Extensions</h2>
		<p class="section-subtitle">A curated collection of extensions to enhance your Envoy deployment</p>

		<div class="extensions-grid">
			{featuredExtensions.map(ext => (
				<ExtensionCard
					name={ext.name}
					type={ext.type}
					categories={ext.categories}
					description={ext.description}
					href={`/extensions/${ext.name}`}
					parent={ext.parent}
					tags={ext.tags}
					filterTypes={ext.filterType}
					highlight={ext.highlight}
				/>
			))}
		</div>

		<div class="browse-all">
			<a href="/extensions" class="btn-secondary">
				Browse All Extensions →
			</a>
		</div>
	</div>
</section>
