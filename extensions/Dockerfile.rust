# Multi-stage build for Rust dynamic modules

FROM debian:bookworm-slim AS builder
ARG RUST_VERSION
ARG EXTENSION_PATH

# Install the exact toolchain without depending on Rust image publication timing.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl clang libclang-dev gcc libc6-dev git && \
    rm -rf /var/lib/apt/lists/*
RUN curl --fail --silent --show-error --location https://sh.rustup.rs -o /tmp/rustup-init.sh && \
    sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}" && \
    rm /tmp/rustup-init.sh

WORKDIR /workspace

# Preserve the workspace dependency graph so releases use the committed lockfile.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY extensions/ ./extensions/
WORKDIR /workspace/extensions/${EXTENSION_PATH}

# Build the Rust extension
RUN cargo build --release --locked --target-dir ./target

# Copy the library from Rust output (with underscores) to original name (with dashes)
RUN mkdir -p /output
RUN ORIGINAL_NAME=$(grep "^name:" manifest.yaml | sed 's/[^:]*:[[:space:]]*//g' | tr -d '"'); \
    RUST_LIB_NAME=$(echo "$ORIGINAL_NAME" | tr '-' '_'); \
    cp ./target/release/lib${RUST_LIB_NAME}.so /output/lib${ORIGINAL_NAME}.so

# Collect all sub-extension manifest.yaml and config.schema.json files preserving their directory structure.
RUN mkdir -p /metadatas; find . -mindepth 2 \( -name 'manifest.yaml' -o -name 'config.schema.json' \) \
    -exec sh -c 'install -D "$1" /metadatas/"$1"' _ {} \;

# Final stage - minimal image with just the compiled library
FROM scratch AS final
ARG EXTENSION_PATH

# Copy the compiled library from builder
COPY --from=builder /output/*.so /
COPY --from=builder /workspace/extensions/${EXTENSION_PATH}/manifest.yaml /
COPY --from=builder /metadatas/ /metadatas/
# Use a wildcard to copy config.schema.json if it exists, since COPY will fail if the file does not exist and we want to
# allow for optional presence of this file.
COPY --from=builder /workspace/extensions/${EXTENSION_PATH}/config.schema.json* /
