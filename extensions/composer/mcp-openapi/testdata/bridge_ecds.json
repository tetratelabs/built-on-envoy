{
  "version_info": "1",
  "resources": [
    {
      "@type": "type.googleapis.com/envoy.config.core.v3.TypedExtensionConfig",
      "name": "envoy.filters.http.mcp_json_rest_bridge",
      "typed_config": {
        "@type": "type.googleapis.com/envoy.extensions.filters.http.mcp_json_rest_bridge.v3.McpJsonRestBridge",
        "tool_config": {
          "tools": [
            {
              "name": "createItem",
              "http_rule": {
                "post": "/items",
                "body": "*"
              },
              "tool_list_config": {
                "description": "Create an item",
                "input_schema": "{\"properties\":{\"name\":{\"type\":\"string\"},\"tag\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"name\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "deleteItem",
              "http_rule": {
                "delete": "/items/{id}"
              },
              "tool_list_config": {
                "description": "Delete an item",
                "input_schema": "{\"properties\":{\"id\":{\"description\":\"The item ID\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"id\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "getItem",
              "http_rule": {
                "get": "/items/{id}"
              },
              "tool_list_config": {
                "description": "Get an item",
                "input_schema": "{\"properties\":{\"id\":{\"description\":\"The item ID\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"id\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "get_search",
              "http_rule": {
                "get": "/search"
              },
              "tool_list_config": {
                "description": "Search items",
                "input_schema": "{\"properties\":{\"q\":{\"description\":\"Search query\",\"type\":\"string\"}},\"required\":[\"q\"],\"type\":\"object\"}"
              }
            }
          ],
          "tool_list_local": {}
        }
      }
    }
  ]
}