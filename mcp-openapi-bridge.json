{
  "version_info": "1",
  "resources": [
    {
      "@type": "type.googleapis.com/envoy.config.core.v3.TypedExtensionConfig",
      "name": "envoy.filters.http.mcp_json_rest_bridge",
      "typed_config": {
        "@type": "type.googleapis.com/envoy.extensions.filters.http.mcp_json_rest_bridge.v3.McpJsonRestBridge",
        "tool_config": {
          "tools": [
            {
              "name": "addPet",
              "http_rule": {
                "post": "/v2/pet",
                "body": "*"
              },
              "tool_list_config": {
                "description": "Add a new pet to the store",
                "input_schema": "{\"properties\":{\"category\":{\"properties\":{\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"},\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"photoUrls\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"status\":{\"description\":\"pet status in the store\",\"enum\":[\"available\",\"pending\",\"sold\"],\"type\":\"string\"},\"tags\":{\"items\":{\"$ref\":\"#/components/schemas/Tag\"},\"type\":\"array\"}},\"required\":[\"name\",\"photoUrls\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "createUser",
              "http_rule": {
                "post": "/v2/user",
                "body": "*"
              },
              "tool_list_config": {
                "description": "This can only be done by the logged in user.",
                "input_schema": "{\"properties\":{\"email\":{\"type\":\"string\"},\"firstName\":{\"type\":\"string\"},\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"lastName\":{\"type\":\"string\"},\"password\":{\"type\":\"string\"},\"phone\":{\"type\":\"string\"},\"userStatus\":{\"description\":\"User Status\",\"format\":\"int32\",\"type\":\"integer\"},\"username\":{\"type\":\"string\"}},\"type\":\"object\"}"
              }
            },
            {
              "name": "createUsersWithArrayInput",
              "http_rule": {
                "post": "/v2/user/createWithArray",
                "body": "*"
              },
              "tool_list_config": {
                "description": "Creates list of users with given input array",
                "input_schema": "{\"type\":\"object\"}"
              }
            },
            {
              "name": "createUsersWithListInput",
              "http_rule": {
                "post": "/v2/user/createWithList",
                "body": "*"
              },
              "tool_list_config": {
                "description": "Creates list of users with given input array",
                "input_schema": "{\"type\":\"object\"}"
              }
            },
            {
              "name": "deleteOrder",
              "http_rule": {
                "delete": "/v2/store/order/{orderId}"
              },
              "tool_list_config": {
                "description": "For valid response try integer IDs with positive integer value. Negative or non-integer values will generate API errors",
                "input_schema": "{\"properties\":{\"orderId\":{\"description\":\"ID of the order that needs to be deleted\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"orderId\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "deletePet",
              "http_rule": {
                "delete": "/v2/pet/{petId}"
              },
              "tool_list_config": {
                "description": "Deletes a pet",
                "input_schema": "{\"properties\":{\"api_key\":{\"type\":\"string\"},\"petId\":{\"description\":\"Pet id to delete\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"petId\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "deleteUser",
              "http_rule": {
                "delete": "/v2/user/{username}"
              },
              "tool_list_config": {
                "description": "This can only be done by the logged in user.",
                "input_schema": "{\"properties\":{\"username\":{\"description\":\"The name that needs to be deleted\",\"type\":\"string\"}},\"required\":[\"username\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "findPetsByStatus",
              "http_rule": {
                "get": "/v2/pet/findByStatus"
              },
              "tool_list_config": {
                "description": "Multiple status values can be provided with comma separated strings",
                "input_schema": "{\"properties\":{\"status\":{\"description\":\"Status values that need to be considered for filter\",\"items\":{\"default\":\"available\",\"enum\":[\"available\",\"pending\",\"sold\"],\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"status\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "findPetsByTags",
              "http_rule": {
                "get": "/v2/pet/findByTags"
              },
              "tool_list_config": {
                "description": "Multiple tags can be provided with comma separated strings. Use tag1, tag2, tag3 for testing.",
                "input_schema": "{\"properties\":{\"tags\":{\"description\":\"Tags to filter by\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"tags\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "getInventory",
              "http_rule": {
                "get": "/v2/store/inventory"
              },
              "tool_list_config": {
                "description": "Returns a map of status codes to quantities",
                "input_schema": "{\"type\":\"object\"}"
              }
            },
            {
              "name": "getOrderById",
              "http_rule": {
                "get": "/v2/store/order/{orderId}"
              },
              "tool_list_config": {
                "description": "For valid response try integer IDs with value \u003e= 1 and \u003c= 10. Other values will generated exceptions",
                "input_schema": "{\"properties\":{\"orderId\":{\"description\":\"ID of pet that needs to be fetched\",\"format\":\"int64\",\"maximum\":10,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"orderId\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "getPetById",
              "http_rule": {
                "get": "/v2/pet/{petId}"
              },
              "tool_list_config": {
                "description": "Returns a single pet",
                "input_schema": "{\"properties\":{\"petId\":{\"description\":\"ID of pet to return\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"petId\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "getUserByName",
              "http_rule": {
                "get": "/v2/user/{username}"
              },
              "tool_list_config": {
                "description": "Get user by user name",
                "input_schema": "{\"properties\":{\"username\":{\"description\":\"The name that needs to be fetched. Use user1 for testing. \",\"type\":\"string\"}},\"required\":[\"username\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "loginUser",
              "http_rule": {
                "get": "/v2/user/login"
              },
              "tool_list_config": {
                "description": "Logs user into the system",
                "input_schema": "{\"properties\":{\"password\":{\"description\":\"The password for login in clear text\",\"type\":\"string\"},\"username\":{\"description\":\"The user name for login\",\"type\":\"string\"}},\"required\":[\"username\",\"password\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "logoutUser",
              "http_rule": {
                "get": "/v2/user/logout"
              },
              "tool_list_config": {
                "description": "Logs out current logged in user session",
                "input_schema": "{\"type\":\"object\"}"
              }
            },
            {
              "name": "placeOrder",
              "http_rule": {
                "post": "/v2/store/order",
                "body": "*"
              },
              "tool_list_config": {
                "description": "Place an order for a pet",
                "input_schema": "{\"properties\":{\"complete\":{\"type\":\"boolean\"},\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"petId\":{\"format\":\"int64\",\"type\":\"integer\"},\"quantity\":{\"format\":\"int32\",\"type\":\"integer\"},\"shipDate\":{\"format\":\"date-time\",\"type\":\"string\"},\"status\":{\"description\":\"Order Status\",\"enum\":[\"placed\",\"approved\",\"delivered\"],\"type\":\"string\"}},\"type\":\"object\"}"
              }
            },
            {
              "name": "updatePet",
              "http_rule": {
                "put": "/v2/pet",
                "body": "*"
              },
              "tool_list_config": {
                "description": "Update an existing pet",
                "input_schema": "{\"properties\":{\"category\":{\"properties\":{\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"},\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"photoUrls\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"status\":{\"description\":\"pet status in the store\",\"enum\":[\"available\",\"pending\",\"sold\"],\"type\":\"string\"},\"tags\":{\"items\":{\"$ref\":\"#/components/schemas/Tag\"},\"type\":\"array\"}},\"required\":[\"name\",\"photoUrls\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "updatePetWithForm",
              "http_rule": {
                "post": "/v2/pet/{petId}"
              },
              "tool_list_config": {
                "description": "Updates a pet in the store with form data",
                "input_schema": "{\"properties\":{\"petId\":{\"description\":\"ID of pet that needs to be updated\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"petId\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "updateUser",
              "http_rule": {
                "put": "/v2/user/{username}",
                "body": "*"
              },
              "tool_list_config": {
                "description": "This can only be done by the logged in user.",
                "input_schema": "{\"properties\":{\"email\":{\"type\":\"string\"},\"firstName\":{\"type\":\"string\"},\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"lastName\":{\"type\":\"string\"},\"password\":{\"type\":\"string\"},\"phone\":{\"type\":\"string\"},\"userStatus\":{\"description\":\"User Status\",\"format\":\"int32\",\"type\":\"integer\"},\"username\":{\"type\":\"string\"}},\"required\":[\"username\"],\"type\":\"object\"}"
              }
            },
            {
              "name": "uploadFile",
              "http_rule": {
                "post": "/v2/pet/{petId}/uploadImage"
              },
              "tool_list_config": {
                "description": "uploads an image",
                "input_schema": "{\"properties\":{\"petId\":{\"description\":\"ID of pet to update\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"petId\"],\"type\":\"object\"}"
              }
            }
          ],
          "tool_list_local": {}
        }
      }
    }
  ]
}